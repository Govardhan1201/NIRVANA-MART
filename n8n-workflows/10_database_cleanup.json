{
  "name": "10 - Database Cleanup (Old Rejected Listings)",
  "nodes": [
    {
      "parameters": {},
      "id": "n10-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.NIRVANA_BASE_URL }}/products/all",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.ADMIN_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "n10-fetch",
      "name": "Fetch All Products (Admin)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const productsRaw = $input.first().json;\nconst products = Array.isArray(productsRaw) ? productsRaw : [];\n\nconst thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000);\n\n// Find rejected products older than 30 days\nconst toDelete = products.filter(p => {\n  return p.status === 'rejected' && new Date(p.created_at) < thirtyDaysAgo;\n});\n\n// Find pending products stuck for 7+ days\nconst sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);\nconst stuckPending = products.filter(p => {\n  return p.status === 'pending' && new Date(p.created_at) < sevenDaysAgo;\n});\n\nreturn [{ json: { toDelete, stuckPending, deleteCount: toDelete.length, stuckCount: stuckPending.length } }];"
      },
      "id": "n10-identify",
      "name": "Identify Stale Listings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const { toDelete } = $json;\nreturn toDelete.map(p => ({ json: p }));"
      },
      "id": "n10-split",
      "name": "Split Products to Delete",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        200
      ]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "={{ $env.NIRVANA_BASE_URL }}/products/{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.ADMIN_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "n10-delete",
      "name": "Delete Stale Product",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        200
      ]
    },
    {
      "parameters": {
        "fromEmail": "NIRVANA MART <nirvanamart0@gmail.com>",
        "toEmail": "={{ $env.ADMIN_EMAIL }}",
        "subject": "🧹 Database Cleanup Complete — NIRVANA MART",
        "html": "\"<div style='font-family:sans-serif;max-width:500px;margin:0 auto;padding:24px;'><div style='background:linear-gradient(135deg,#6366f1,#8b5cf6);padding:24px;border-radius:10px;text-align:center;color:white;margin-bottom:20px;'><h1 style='margin:0;'>🧹 Cleanup Done!</h1></div><div style='background:white;border:1px solid #e5e7eb;padding:20px;border-radius:10px;'><p style='color:#333;'>Database cleanup completed successfully.</p><table style='width:100%;border-collapse:collapse;'><tr style='border-bottom:1px solid #eee;'><td style='padding:10px;color:#666;'>Rejected listings deleted</td><td style='padding:10px;font-weight:700;color:#ef4444;'>{{ $('Identify Stale Listings').first().json.deleteCount",
        "options": {}
      },
      "id": "n10-summary",
      "name": "Email Cleanup Summary",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        1080,
        420
      ]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Fetch All Products (Admin)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch All Products (Admin)": {
      "main": [
        [
          {
            "node": "Identify Stale Listings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Identify Stale Listings": {
      "main": [
        [
          {
            "node": "Split Products to Delete",
            "type": "main",
            "index": 0
          },
          {
            "node": "Email Cleanup Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Products to Delete": {
      "main": [
        [
          {
            "node": "Delete Stale Product",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "nirvana-wf-10"
}