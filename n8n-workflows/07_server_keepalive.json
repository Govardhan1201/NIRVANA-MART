{
  "name": "07 - Server Keep-Alive Ping (Anti-Sleep)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/14 * * * *"
            }
          ]
        }
      },
      "id": "n07-trigger",
      "name": "Every 14 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://nirvana-mart.onrender.com/api/products",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "n07-ping",
      "name": "Ping Server",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first();\nconst isArray = Array.isArray(response.json);\nconst statusOk = isArray && response.json.length >= 0;\nconst timestamp = new Date().toISOString();\nreturn [{\n  json: {\n    timestamp,\n    status: statusOk ? 'UP' : 'ERROR',\n    responseType: typeof response.json,\n    productCount: isArray ? response.json.length : 0,\n    message: statusOk ? `✅ Server alive at ${timestamp}` : `⚠️ Unexpected response at ${timestamp}`\n  }\n}];"
      },
      "id": "n07-check",
      "name": "Check Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "c07",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ERROR",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "n07-if-error",
      "name": "Server Down?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "NIRVANA MART <nirvanamart0@gmail.com>",
        "toEmail": "={{ $env.ADMIN_EMAIL }}",
        "subject": "🚨 NIRVANA MART Server Possibly Down!",
        "html": "\"<div style='font-family:sans-serif;max-width:500px;margin:0 auto;'><div style='background:#dc2626;padding:24px;border-radius:10px;text-align:center;color:white;'><h1 style='margin:0;'>🚨 Server Alert</h1><p style='margin:8px 0 0;opacity:0.85;'>Detected at {{ $json.timestamp",
        "options": {}
      },
      "id": "n07-alert-email",
      "name": "Send Down Alert Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        1080,
        200
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "value": "={{ $env.GOOGLE_SHEETS_ID }}",
          "__rl": true,
          "mode": "id"
        },
        "sheetName": {
          "value": "Uptime Log",
          "__rl": true,
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $('Check Response').first().json.timestamp }}",
            "Status": "={{ $('Check Response').first().json.status }}",
            "Product Count": "={{ $('Check Response').first().json.productCount }}"
          }
        }
      },
      "id": "n07-log-sheets",
      "name": "Log to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [
        1080,
        420
      ]
    },
    {
      "parameters": {},
      "id": "n07-server-ok",
      "name": "Server OK ✅",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1080,
        580
      ]
    }
  ],
  "connections": {
    "Every 14 Minutes": {
      "main": [
        [
          {
            "node": "Ping Server",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ping Server": {
      "main": [
        [
          {
            "node": "Check Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Response": {
      "main": [
        [
          {
            "node": "Server Down?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Server Down?": {
      "main": [
        [
          {
            "node": "Send Down Alert Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log to Google Sheets",
            "type": "main",
            "index": 0
          },
          {
            "node": "Server OK ✅",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "nirvana-wf-07"
}