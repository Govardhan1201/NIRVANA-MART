{
  "name": "05 - Order Confirmation Notifications",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nirvana-order-placed",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "n05-trigger",
      "name": "Webhook: Order Placed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "nirvana-order-placed"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\": \"ok\"}"
      },
      "id": "n05-respond",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body;\nconst order = body;\n\n// Buyer confirmation email\nconst buyerHtml = `\n<div style='font-family:Segoe UI,sans-serif;max-width:600px;margin:0 auto;background:#f5f5f5;padding:24px;border-radius:12px;'>\n  <div style='background:linear-gradient(135deg,#10b981,#059669);padding:28px;border-radius:10px;text-align:center;margin-bottom:24px;'>\n    <div style='font-size:3rem;margin-bottom:8px;'>✅</div>\n    <h1 style='color:white;margin:0;font-size:1.3rem;'>Order Confirmed!</h1>\n    <p style='color:rgba(255,255,255,0.8);margin:6px 0 0;'>Order #${order.order_id || order.id}</p>\n  </div>\n  <div style='background:white;padding:24px;border-radius:10px;margin-bottom:20px;'>\n    <p style='color:#333;'>Hi <strong>${order.buyer_name}</strong>,</p>\n    <p style='color:#555;'>Your order has been confirmed. Here are the details:</p>\n    <table style='width:100%;border-collapse:collapse;margin:16px 0;'>\n      <tr style='border-bottom:1px solid #eee;'><td style='padding:10px;color:#888;'>Product</td><td style='padding:10px;font-weight:700;'>${order.product_title}</td></tr>\n      <tr style='border-bottom:1px solid #eee;'><td style='padding:10px;color:#888;'>Price</td><td style='padding:10px;font-weight:700;color:#c8923a;'>₹${order.price?.toLocaleString('en-IN')}</td></tr>\n      <tr style='border-bottom:1px solid #eee;'><td style='padding:10px;color:#888;'>Seller</td><td style='padding:10px;'>${order.seller_name}</td></tr>\n      <tr><td style='padding:10px;color:#888;'>Seller Contact</td><td style='padding:10px;'>${order.seller_phone || 'Via platform chat'}</td></tr>\n    </table>\n    <p style='color:#555;font-size:0.9rem;'>Contact the seller to arrange pickup/delivery.</p>\n  </div>\n  <div style='text-align:center;'><a href='https://nirvana-mart.onrender.com/buyer.html' style='display:inline-block;background:#10b981;color:white;padding:14px 32px;border-radius:8px;text-decoration:none;font-weight:700;'>View My Orders →</a></div>\n  <p style='color:#aaa;font-size:0.78rem;text-align:center;margin-top:20px;'>NIRVANA MART — Campus Marketplace</p>\n</div>`;\n\n// Seller notification email\nconst sellerHtml = `\n<div style='font-family:Segoe UI,sans-serif;max-width:600px;margin:0 auto;background:#f5f5f5;padding:24px;border-radius:12px;'>\n  <div style='background:linear-gradient(135deg,#c8923a,#e8b86d);padding:28px;border-radius:10px;text-align:center;margin-bottom:24px;'>\n    <div style='font-size:3rem;margin-bottom:8px;'>🎉</div>\n    <h1 style='color:white;margin:0;font-size:1.3rem;'>You Made a Sale!</h1>\n  </div>\n  <div style='background:white;padding:24px;border-radius:10px;margin-bottom:20px;'>\n    <p style='color:#333;'>Hi <strong>${order.seller_name}</strong>,</p>\n    <p style='color:#555;'>Great news — someone bought your item!</p>\n    <table style='width:100%;border-collapse:collapse;margin:16px 0;'>\n      <tr style='border-bottom:1px solid #eee;'><td style='padding:10px;color:#888;'>Product Sold</td><td style='padding:10px;font-weight:700;'>${order.product_title}</td></tr>\n      <tr style='border-bottom:1px solid #eee;'><td style='padding:10px;color:#888;'>Amount</td><td style='padding:10px;font-weight:700;color:#10b981;'>₹${order.price?.toLocaleString('en-IN')}</td></tr>\n      <tr><td style='padding:10px;color:#888;'>Buyer</td><td style='padding:10px;'>${order.buyer_name}</td></tr>\n    </table>\n    <p style='color:#555;font-size:0.9rem;'>The buyer will contact you to arrange pickup.</p>\n  </div>\n  <div style='text-align:center;'><a href='https://nirvana-mart.onrender.com/seller.html' style='display:inline-block;background:#c8923a;color:white;padding:14px 32px;border-radius:8px;text-decoration:none;font-weight:700;'>View My Listings →</a></div>\n  <p style='color:#aaa;font-size:0.78rem;text-align:center;margin-top:20px;'>NIRVANA MART — Campus Marketplace</p>\n</div>`;\n\nreturn [\n  { json: { to: order.buyer_email, html: buyerHtml, subject: `✅ Order Confirmed — ${order.product_title}`, type: 'buyer' } },\n  { json: { to: order.seller_email, html: sellerHtml, subject: `🎉 You made a sale! — ${order.product_title}`, type: 'seller' } }\n];"
      },
      "id": "n05-prepare",
      "name": "Prepare Both Emails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        360
      ]
    },
    {
      "parameters": {
        "fromEmail": "NIRVANA MART <nirvanamart0@gmail.com>",
        "toEmail": "={{ $json.to }}",
        "subject": "={{$json.subject}}",
        "html": "{{ JSON.stringify($json.html)",
        "options": {}
      },
      "id": "n05-send-email",
      "name": "Send Email (Buyer + Seller)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        660,
        360
      ]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "days"
      },
      "id": "n05-wait-review",
      "name": "Wait 5 Days",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        880,
        260
      ]
    },
    {
      "parameters": {
        "fromEmail": "NIRVANA MART <nirvanamart0@gmail.com>",
        "toEmail": "={{ $('Webhook: Order Placed').first().json.body.buyer_email }}",
        "subject": "⭐ How was your purchase from NIRVANA MART?",
        "html": "\"<div style='font-family:Segoe UI,sans-serif;max-width:600px;margin:0 auto;background:#f5f5f5;padding:24px;border-radius:12px;'><div style='background:linear-gradient(135deg,#6366f1,#8b5cf6);padding:28px;border-radius:10px;text-align:center;margin-bottom:24px;'><h1 style='color:white;margin:0;font-size:1.3rem;'>How was your experience? ⭐</h1></div><div style='background:white;padding:24px;border-radius:10px;margin-bottom:20px;'><p style='color:#555;line-height:1.7;'>Hi {{ $('Webhook: Order Placed').first().json.body.buyer_name",
        "options": {}
      },
      "id": "n05-review-request",
      "name": "Send Review Request",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        1100,
        260
      ]
    }
  ],
  "connections": {
